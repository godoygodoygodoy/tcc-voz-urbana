Options -MultiViews
DirectoryIndex index.html
RewriteEngine On
RewriteBase /tecti/2026/gpec03/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Public build assets only. API/media authorization remains private and uncached.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|webp|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "^.+-[A-Za-z0-9_-]{8}\.(?:js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(?:index\.html|deployment\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
