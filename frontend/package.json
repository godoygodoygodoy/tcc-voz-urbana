    "test:collections:browser": "node --experimental-vm-modules tests/collections-browser.cjs",
    "test:stories:browser": "node --experimental-vm-modules tests/stories-browser.cjs",
    "test:polls:browser": "node --experimental-vm-modules tests/polls-browser.cjs",
    "test:activity:browser": "node --experimental-vm-modules tests/activity-browser.cjs",
    "test:discussion:browser": "node --experimental-vm-modules tests/discussion-browser.cjs",
    "test:geography:browser": "node --experimental-vm-modules tests/geography-browser.cjs",
    "test:map": "node --test tests/map-color.test.cjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
