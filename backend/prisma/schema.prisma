generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id                     String                @id @default(uuid()) @db.Char(36)
  nome                   String                @db.VarChar(100)
  email                  String                @unique @db.VarChar(150)
  senhaHash              String                @map("senha_hash") @db.VarChar(255)
  fotoPerfil             String?               @map("foto_perfil") @db.VarChar(500)
  dataCriacao            DateTime              @default(now()) @map("data_criacao")
  username               String?               @unique @db.VarChar(30)
  telefone               String?               @db.VarChar(30)
  bio                    String?               @db.Text
  apresentacao String? @db.VarChar(120)
  capaUrl String? @map("capa_url") @db.VarChar(500)
  perfilPrivado          Boolean               @default(false) @map("perfil_privado")
  nivel                  String                @default("USUARIO") @db.VarChar(20)
  // Campos legados preservados para futura reativacao da verificacao de e-mail.
  emailVerificado        Boolean               @default(false) @map("email_verificado")
  tokenVerificacao       String?               @unique @map("token_verificacao") @db.VarChar(100)
  tokenVerificacaoExpira DateTime?             @map("token_verificacao_expira")
  admin                  Admin?
  atualizacoes           AtualizacaoProblema[]
  comentarios            Comentario[]
  logs                   Log[]
  notificacoes           Notificacao[]
  problemas              Problema[]
  votos                  Voto[]
  publicacoesSalvas      PublicacaoSalva[]
  colecoes               Colecao[]
  stories                Story[]
  storiesVistos          StoryVisualizacao[]
  votosEnquetes          VotoEnquete[]
  preferenciasNotificacao PreferenciaNotificacao[]
  conquistas ConquistaUsuario[]
  visitas                Visita[]
  seguindo               Seguimento[]          @relation("seguimentoOrigem")
  seguidores             Seguimento[]          @relation("seguimentoDestino")
  conversasIniciadas     Conversa[]             @relation("conversaRemetente")
  conversasRecebidas     Conversa[]             @relation("conversaDestinatario")
  mensagensEnviadas      Mensagem[]
  confirmacoesProblemas ConfirmacaoProblema[]

  @@map("usuarios")
}

model Categoria {
  id        String     @id @default(uuid()) @db.Char(36)
  nome      String     @unique @db.VarChar(80)
  descricao String     @db.Text
  icone     String?    @db.VarChar(10)
  cor       String?    @db.VarChar(7)
  problemas Problema[]

  @@map("categorias")
}

model Problema {
  id             String                @id @default(uuid()) @db.Char(36)
  titulo         String                @db.VarChar(150)
  descricao      String                @db.Text
  latitude       Decimal?              @db.Decimal(10, 7)
  longitude      Decimal?              @db.Decimal(10, 7)
  endereco       String?               @db.VarChar(300)
  complemento    String?               @db.VarChar(120)
  cep            String?               @db.VarChar(8)
  estado         String?               @db.VarChar(80)
  cidade         String?               @db.VarChar(120)
  bairro         String?               @db.VarChar(120)
  status         StatusProblema        @default(ABERTO)
  dataCriacao    DateTime              @default(now()) @map("data_criacao")
  dataOcorrencia DateTime?             @map("data_ocorrencia")
  editadaEm      DateTime?             @map("editada_em")
  fixadaEm DateTime? @map("fixada_em")
  usuarioId      String                @map("usuario_id") @db.Char(36)
  categoriaId    String                @map("categoria_id") @db.Char(36)
  atualizacoes   AtualizacaoProblema[]
  comentarios    Comentario[]
  imagens        Imagem[]
  categoria      Categoria             @relation(fields: [categoriaId], references: [id])
  usuario        Usuario               @relation(fields: [usuarioId], references: [id])
  votos          Voto[]
  salvos         PublicacaoSalva[]
  enquete        Enquete?
  etapaCodigo    String? @map("etapa_codigo") @db.VarChar(40)
  etapa          EtapaProblema? @relation(fields:[etapaCodigo],references:[codigo],onDelete:SetNull,onUpdate:Restrict,map:"problemas_etapa_fk")
  confirmacoes   ConfirmacaoProblema[]

  @@index([latitude, longitude])
  @@index([status])
  @@index([categoriaId])
  @@index([usuarioId], map: "problemas_usuario_id_fkey")
  @@index([estado, cidade])
  @@index([estado,cidade,bairro,dataCriacao], map:"problemas_regiao_data_idx")
  @@index([dataCriacao], map: "problemas_data_idx")
  @@index([usuarioId, dataCriacao], map: "problemas_usuario_data_idx")
  @@index([usuarioId,fixadaEm,dataCriacao],map:"problemas_usuario_destaques_idx")
  @@index([etapaCodigo],map:"problemas_etapa_codigo_idx")
  @@map("problemas")
}

model PublicacaoSalva {
  acompanhando Boolean @default(false)
  id          String   @id @default(uuid()) @db.Char(36)
  usuarioId   String   @map("usuario_id") @db.Char(36)
  problemaId  String   @map("problema_id") @db.Char(36)
  criadaEm    DateTime @default(now()) @map("criada_em")
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  problema    Problema @relation(fields: [problemaId], references: [id], onDelete: Cascade)

  colecoes    ItemColecao[]

  @@unique([usuarioId, problemaId])
  @@index([usuarioId, criadaEm])
  @@index([usuarioId,acompanhando],map:"salvos_usuario_acompanhando_idx")
  @@index([problemaId,acompanhando],map:"salvos_problema_acompanhando_idx")
  @@map("publicacoes_salvas")
}

model Imagem {
  id         String     @id @default(uuid()) @db.Char(36)
  url        String     @db.VarChar(500)
  problemaId String     @map("problema_id") @db.Char(36)
  tipo       TipoImagem @default(ANTES)
  proporcao  String?    @db.VarChar(10)
  problema   Problema   @relation(fields: [problemaId], references: [id], onDelete: Cascade)

  @@index([problemaId], map: "imagens_problema_id_fkey")
  @@map("imagens")
}

model Comentario {
  parentId String? @map("resposta_a_id") @db.Char(36)
  parent Comentario? @relation("respostasComentarios",fields:[parentId],references:[id],onDelete:SetNull,onUpdate:Restrict)
  respostas Comentario[] @relation("respostasComentarios")
  id          String   @id @default(uuid()) @db.Char(36)
  texto       String   @db.Text
  dataCriacao DateTime @default(now()) @map("data_criacao")
  usuarioId   String   @map("usuario_id") @db.Char(36)
  problemaId  String   @map("problema_id") @db.Char(36)
  problema    Problema @relation(fields: [problemaId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "comentarios_problema_fk")
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "comentarios_usuario_fk")

  @@index([problemaId, dataCriacao], map: "comentarios_problema_data_idx")
  @@index([usuarioId], map: "comentarios_usuario_fk")
  @@index([problemaId,parentId,dataCriacao], map:"comentarios_problema_resposta_data_idx")
  @@index([parentId,dataCriacao], map:"comentarios_resposta_data_idx")
  @@map("comentarios")
}

model Notificacao {
  chaveEvento String? @unique @map("chave_evento") @db.VarChar(191)
  id          String   @id @default(uuid()) @db.Char(36)
  tipo        String   @db.VarChar(50)
  titulo      String   @db.VarChar(150)
  mensagem    String   @db.VarChar(500)
  lida        Boolean  @default(false)
  link        String?  @db.VarChar(300)
  dataCriacao DateTime @default(now()) @map("data_criacao")
  usuarioId   String   @map("usuario_id") @db.Char(36)
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "notificacoes_usuario_fk")

  @@index([usuarioId, lida, dataCriacao], map: "notificacoes_usuario_lida_data_idx")
  @@map("notificacoes")
}

model AtualizacaoProblema {
  etapaCodigo String? @map("etapa_codigo") @db.VarChar(40)
  etapaNome String? @map("etapa_nome") @db.VarChar(80)
  statusAnterior StatusProblema? @map("status_anterior")
  entrega     EntregaAtualizacao?
  id          String          @id @default(uuid()) @db.Char(36)
  texto       String          @db.Text
  status      StatusProblema?
  dataCriacao DateTime        @default(now()) @map("data_criacao")
  usuarioId   String          @map("usuario_id") @db.Char(36)
  problemaId  String          @map("problema_id") @db.Char(36)
  problema    Problema        @relation(fields: [problemaId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "atualizacoes_problema_fk")
  usuario     Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "atualizacoes_usuario_fk")

  @@index([problemaId, dataCriacao], map: "atualizacoes_problemas_data_idx")
  @@index([usuarioId], map: "atualizacoes_usuario_fk")
  @@map("atualizacoes_problemas")
}

model EtapaProblema {
  codigo String @id @db.VarChar(40)
  nome String? @db.VarChar(80)
  statusBase StatusProblema @map("status_base")
  cor String @default("#7C3AED") @db.VarChar(7)
  ativa Boolean @default(true)
  problemas Problema[]
  @@map("etapas_problemas")
}

model ConfirmacaoProblema {
  id String @id @default(uuid()) @db.Char(36)
  usuarioId String @map("usuario_id") @db.Char(36)
  problemaId String @map("problema_id") @db.Char(36)
  escolha String @db.VarChar(30)
  registradaEm DateTime @default(now()) @map("registrada_em")
  usuario Usuario @relation(fields:[usuarioId],references:[id],onDelete:Cascade,onUpdate:Restrict,map:"confirmacoes_usuario_fk")
  problema Problema @relation(fields:[problemaId],references:[id],onDelete:Cascade,onUpdate:Restrict,map:"confirmacoes_problema_fk")
  @@unique([usuarioId,problemaId],map:"confirmacoes_usuario_problema_key")
  @@index([problemaId,escolha,registradaEm], map:"confirmacoes_problema_escolha_data_idx")
  @@map("confirmacoes_problemas")
}

model EntregaAtualizacao {
  historicoId String @id @map("historico_id") @db.Char(36)
  cursorUsuarioId String? @map("cursor_usuario_id") @db.Char(36)
  criadaEm DateTime @default(now()) @map("criada_em")
  historico AtualizacaoProblema @relation(fields:[historicoId], references:[id], onDelete:Cascade, onUpdate:Restrict)

  @@index([criadaEm,historicoId], map:"entregas_atualizacao_data_idx")
  @@map("entregas_atualizacao")
}

model Voto {
  id         String   @id @default(uuid()) @db.Char(36)
  tipo       TipoVoto @default(CONFIRMAR)
  usuarioId  String   @map("usuario_id") @db.Char(36)
  problemaId String   @map("problema_id") @db.Char(36)
  problema   Problema @relation(fields: [problemaId], references: [id], onDelete: Cascade)
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, problemaId])
  @@index([problemaId], map: "votos_problema_id_fkey")
  @@map("votos")
}

// Reuses the existing table and preserves all relationship IDs and statuses.
model Seguimento {
  id            String        @id @default(uuid()) @db.Char(36)
  status        StatusAmizade  @default(PENDENTE)
  followerId    String        @map("solicitante_id") @db.Char(36)
  followingId   String        @map("destinatario_id") @db.Char(36)
  criadaEm      DateTime      @default(now()) @map("criada_em")
  atualizadaEm  DateTime      @updatedAt @map("atualizada_em")
  follower      Usuario       @relation("seguimentoOrigem", fields: [followerId], references: [id], onDelete: Cascade, map: "amizades_solicitante_id_fkey")
  following     Usuario       @relation("seguimentoDestino", fields: [followingId], references: [id], onDelete: Cascade, map: "amizades_destinatario_id_fkey")

  @@unique([followerId, followingId], map: "amizades_solicitante_id_destinatario_id_key")
  @@index([followingId, status], map: "amizades_destinatario_id_status_idx")
  @@index([followerId, status], map: "amizades_solicitante_id_status_idx")
  @@map("amizades")
}

model Conversa {
  id              String    @id @default(uuid()) @db.Char(36)
  usuarioAId      String    @map("usuario_a_id") @db.Char(36)
  usuarioBId      String    @map("usuario_b_id") @db.Char(36)
  criadaEm        DateTime  @default(now()) @map("criada_em")
  atualizadaEm    DateTime  @updatedAt @map("atualizada_em")
  usuarioA        Usuario   @relation("conversaRemetente", fields: [usuarioAId], references: [id], onDelete: Cascade)
  usuarioB        Usuario   @relation("conversaDestinatario", fields: [usuarioBId], references: [id], onDelete: Cascade)
  mensagens       Mensagem[]

  @@unique([usuarioAId, usuarioBId])
  @@index([usuarioAId, atualizadaEm])
  @@index([usuarioBId, atualizadaEm])
  @@map("conversas")
}

model Mensagem {
  id          String   @id @default(uuid()) @db.Char(36)
  texto       String   @db.Text
  criadaEm    DateTime @default(now()) @map("criada_em")
  conversaId  String   @map("conversa_id") @db.Char(36)
  remetenteId String   @map("remetente_id") @db.Char(36)
  conversa    Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  remetente   Usuario  @relation(fields: [remetenteId], references: [id], onDelete: Cascade)

  @@index([conversaId, criadaEm])
  @@index([conversaId, remetenteId])
  @@index([remetenteId, criadaEm])
  @@map("mensagens")
}

enum StatusAmizade {
  PENDENTE
  ACEITA
  RECUSADA
}

model Admin {
  id        String     @id @default(uuid()) @db.Char(36)
  nivel     NivelAdmin @default(MODERADOR)
  usuarioId String     @unique @map("usuario_id") @db.Char(36)
  usuario   Usuario    @relation(fields: [usuarioId], references: [id])

  @@map("admins")
}

model Log {
  id        String   @id @default(uuid())
  acao      String   @db.VarChar(200)
  data      DateTime @default(now())
  usuarioId String   @map("usuario_id") @db.Char(36)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("logs")
}

model Visita {
  id          String   @id @default(uuid()) @db.Char(36)
  visitanteId String   @map("visitante_id") @db.VarChar(128)
  caminho     String   @db.VarChar(255)
  usuarioId   String?  @map("usuario_id") @db.Char(36)
  criadaEm    DateTime @default(now()) @map("criada_em")
  usuario     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([criadaEm])
  @@index([visitanteId, criadaEm])
  @@index([caminho, criadaEm])
  @@index([usuarioId, criadaEm])
  @@map("visitas")
}

enum StatusProblema {
  ABERTO
  EM_ANDAMENTO
  RESOLVIDO
  REJEITADO
}

enum NivelAdmin {
  MODERADOR
  ADMIN
  SUPER_ADMIN
}

enum TipoVoto {
  CONFIRMAR
  RESOLVER
}

enum TipoImagem {
  ANTES
  DEPOIS
}

model Colecao {
  id        String @id @default(uuid()) @db.Char(36)
  usuarioId String @map("usuario_id") @db.Char(36)
  nome      String @db.VarChar(80)
  privada   Boolean @default(true)
  criadaEm  DateTime @default(now()) @map("criada_em")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  itens     ItemColecao[]
  @@index([usuarioId, criadaEm])
  @@map("colecoes")
}
model ItemColecao {
  id          String @id @default(uuid()) @db.Char(36)
  colecaoId   String @map("colecao_id") @db.Char(36)
  salvoId     String @map("salvo_id") @db.Char(36)
  criadaEm    DateTime @default(now()) @map("criada_em")
  colecao     Colecao @relation(fields: [colecaoId], references: [id], onDelete: Cascade)
  salvo       PublicacaoSalva @relation(fields: [salvoId], references: [id], onDelete: Cascade)
  @@unique([colecaoId, salvoId])
  @@index([salvoId])
  @@map("itens_colecoes")
}

model Story {
 id String @id @default(uuid()) @db.Char(36)
 usuarioId String @map("usuario_id") @db.Char(36)
 url String @db.VarChar(500)
 posterUrl String? @map("poster_url") @db.VarChar(500)
 mime String @db.VarChar(50)
 audiencia String @default("SEGUIDORES") @db.VarChar(20)
 criadaEm DateTime @default(now()) @map("criada_em")
 expiraEm DateTime @map("expira_em")
 excluidoEm DateTime? @map("excluido_em")
 usuario Usuario @relation(fields:[usuarioId],references:[id],onDelete:Cascade)
 visualizacoes StoryVisualizacao[]
 @@index([expiraEm, excluidoEm])
 @@index([usuarioId, criadaEm])
 @@map("stories")
}
model StoryVisualizacao {
 id String @id @default(uuid()) @db.Char(36)
 reacao String? @db.VarChar(10)
 storyId String @map("story_id") @db.Char(36)
 usuarioId String @map("usuario_id") @db.Char(36)
 criadaEm DateTime @default(now()) @map("criada_em")
 story Story @relation(fields:[storyId],references:[id],onDelete:Cascade)
 usuario Usuario @relation(fields:[usuarioId],references:[id],onDelete:Cascade)
 @@unique([storyId, usuarioId])
 @@index([usuarioId])
 @@map("stories_visualizacoes")
}

model Enquete {
 id String @id @default(uuid()) @db.Char(36)
 problemaId String @unique @map("problema_id") @db.Char(36)
 pergunta String @db.VarChar(200)
 encerraEm DateTime? @map("encerra_em")
 criadaEm DateTime @default(now()) @map("criada_em")
 problema Problema @relation(fields:[problemaId],references:[id],onDelete:Cascade)
 opcoes EnqueteOpcao[]
 votos VotoEnquete[]
 @@map("enquetes")
}
model EnqueteOpcao {
 id String @id @default(uuid()) @db.Char(36)
 enqueteId String @map("enquete_id") @db.Char(36)
 texto String @db.VarChar(100)
 ordem Int
 enquete Enquete @relation(fields:[enqueteId],references:[id],onDelete:Cascade)
 votos VotoEnquete[]
 @@unique([enqueteId,id])
 @@unique([enqueteId,ordem])
 @@map("enquetes_opcoes")
}
model VotoEnquete {
 id String @id @default(uuid()) @db.Char(36)
 usuarioId String @map("usuario_id") @db.Char(36)
 enqueteId String @map("enquete_id") @db.Char(36)
 opcaoId String @map("opcao_id") @db.Char(36)
 criadaEm DateTime @default(now()) @map("criada_em")
 usuario Usuario @relation(fields:[usuarioId],references:[id],onDelete:Cascade)
 enquete Enquete @relation(fields:[enqueteId],references:[id],onDelete:Cascade)
 opcao EnqueteOpcao @relation(fields:[enqueteId,opcaoId],references:[enqueteId,id],onDelete:Cascade)
 @@unique([usuarioId,enqueteId])
 @@index([enqueteId,opcaoId])
 @@map("enquetes_votos")
}

model PreferenciaNotificacao {
 id String @id @default(uuid()) @db.Char(36)
 usuarioId String @map("usuario_id") @db.Char(36)
 tipo String @db.VarChar(50)
 ativa Boolean @default(true)
 usuario Usuario @relation(fields:[usuarioId],references:[id],onDelete:Cascade)
 @@unique([usuarioId,tipo])
 @@map("preferencias_notificacoes")
}

model ConquistaUsuario {
 id String @id @default(uuid()) @db.Char(36)
 usuarioId String @map("usuario_id") @db.Char(36)
 codigo String @db.VarChar(40)
 desbloqueadaEm DateTime @default(now()) @map("desbloqueada_em")
 usuario Usuario @relation(fields:[usuarioId],references:[id],onDelete:Cascade)
 @@unique([usuarioId,codigo])
 @@map("conquistas_usuarios")
}
