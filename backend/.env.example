# Fonte principal para runtime e Prisma CLI. Codifique caracteres especiais da senha.
DATABASE_URL=mysql://usuario:senha@localhost:3306/voz_urbana
# Alternativas locais somente quando DATABASE_URL não estiver definida:
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_USER=usuario
# DATABASE_PASSWORD=
# DATABASE_NAME=voz_urbana
# TLS: use também ?sslaccept=strict na DATABASE_URL para a CLI Prisma.
DATABASE_SSL=false
# Caminho do certificado CA, se exigido; use &sslcert=/caminho/ca.pem na URL da CLI.
DATABASE_SSL_CA=
PORT=5000
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:3000/tecti/2026/gpec03
# Origens adicionais, separadas por vírgula, sem barra final.
CORS_ORIGIN=
# Produção: caminho absoluto do disco persistente do Render.
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
# Backup em armazenamento privado persistente externo ao checkout.
# PERSISTENCE_STATE_FILE=/var/private/voz-urbana/identity.json
BACKUP_ENABLED=false
# BACKUP_DIR=/var/private/voz-urbana/backups
BACKUP_INTERVAL_HOURS=24
# MYSQL_BIN=/usr/bin/mysql
# MYSQLDUMP_BIN=/usr/bin/mysqldump
# MYSQL_CLIENT_FLAVOR=mariadb
# BACKUP_VERIFY_DATABASE_URL=mysql://usuario:senha@host-isolado/audit_restore_check
# TEST_DATABASE_URL=mysql://usuario:senha@localhost:3306/voz_urbana_test
# TEST_DATABASE_ALLOW_CLEANUP=true
# Supabase Storage (somente backend; não use a service role no frontend).
# Com as variáveis preenchidas, novos uploads usam os buckets avatars, posts e reports.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_ENABLED=true
SUPABASE_STORAGE_PUBLIC=true
# Recuperação de senha e notificações por email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SEND_NOTIFICATION_EMAIL=false
# Somente para execução manual do seed administrativo.
# Email válido da conta com acesso total; conta existente é promovida sem trocar senha.
ADMIN_EMAIL=
# Para conta nova: mínimo 12 caracteres, máximo 72 bytes. Nunca versionar a senha.
ADMIN_PASSWORD=
