# Database (MySQL/MariaDB do XAMPP; padrão: root sem senha)
DATABASE_URL=mysql://root:@localhost:3306/voz_urbana
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=voz_urbana

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
ADMIN_EMAIL=danielgodoy.txt@gmail.com
# Necessária somente se o seed precisar criar essa conta.
ADMIN_PASSWORD=defina-uma-senha-forte-se-for-criar-a-conta

# CORS
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Email (obrigatório para confirmação de conta). Para Gmail, ative a verificação
# em duas etapas e gere uma Senha de app de 16 caracteres.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_gmail_app_password
SMTP_FROM=your_email@gmail.com
SEND_NOTIFICATION_EMAIL=false
