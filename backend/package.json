{
  "name": "voz-urbana-backend",
  "version": "1.0.0",
  "description": "Backend para plataforma VOZ URBANA - Reportagem de problemas urbanos",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watchAll=false",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --watchAll=false",
    "test:verbose": "node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose --watchAll=false",
    "prisma:seed": "node prisma/seed.js",
    "geocode:existing": "node scripts/geocode-existing.js",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "node scripts/deploy-database.js",
    "backup:create": "node scripts/backup.js create",
    "backup:verify": "node scripts/backup.js verify",
    "test:safety": "node --test tests/data-safety.node.js tests/people-search.node.js",
    "test:followers": "node --experimental-vm-modules --test tests/followers.node.js tests/followers-api.node.js",
    "test:followers:db": "node --test tests/followers-mysql.node.js",
    "test:performance": "node --experimental-vm-modules --test tests/performance.node.js",
    "test:profile-connections": "node --experimental-vm-modules --test tests/profile-connections.node.js",
    "test:expansion": "node --experimental-vm-modules --test tests/collections.node.js tests/stories.node.js tests/stories-api.node.js tests/story-media.node.js tests/story-ranges.node.js tests/media-validation.node.js tests/polls.node.js tests/notifications.node.js tests/comments-replies.node.js tests/participation.node.js tests/storage-ownership.node.js tests/problem-status.node.js tests/geography.node.js tests/tracking.node.js tests/profile-features.node.js tests/sharing.node.js",
    "test:production": "node --experimental-vm-modules --test tests/production-config.node.js tests/people-search.node.js tests/data-safety.node.js",
    "diagnose:production": "node scripts/diagnose-production.js --read-only"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "urbano",
    "problemas",
    "reportagem",
    "mapa"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.1",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "nodemon": "^2.0.20",
    "prisma": "^7.8.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  }
}
